---
import { getSession } from '../../lib/auth';

const session = getSession(Astro.cookies);
const currentPath = Astro.url.pathname;

const navLinks = [
  { name: 'Inicio', href: '/' },
  { name: 'Explorar Mangas', href: '/mangas' },
  { name: 'Últimos Capítulos', href: '/#ultimos-capitulos' },
  { name: 'Mi Biblioteca', href: '/biblioteca' },
];
---

<header class="sticky top-0 z-40 w-full border-b border-bl-cardBorder/60 bg-bl-dark/85 backdrop-blur-md transition-all">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16 gap-4">
      
      <!-- LOGO -->
      <a href="/" class="flex items-center gap-2 group shrink-0">
        <img
          src="/images/logo-blkscan.png"
          alt="BLK SCAN"
          class="h-8 sm:h-9 w-auto object-contain drop-shadow-[0_0_12px_rgba(0,210,255,0.35)] group-hover:drop-shadow-[0_0_18px_rgba(0,210,255,0.6)] transition-all"
        />
      </a>

      <!-- DESKTOP NAVIGATION -->
      <nav class="hidden md:flex items-center gap-1 lg:gap-2">
        {navLinks.map((link) => {
          const isActive = currentPath === link.href;
          return (
            <a
              href={link.href}
              class={`px-3 py-2 text-sm font-medium rounded-md transition-colors ${
                isActive
                  ? 'text-bl-primary bg-bl-surface'
                  : 'text-gray-300 hover:text-white hover:bg-bl-surface/50'
              }`}
            >
              {link.name}
            </a>
          );
        })}
      </nav>

      <!-- SEARCH BAR & ACTIONS -->
      <div class="flex items-center gap-3">
        <!-- Buscador Rápido -->
        <form action="/mangas" method="GET" class="hidden sm:flex relative items-center">
          <input
            type="text"
            name="q"
            placeholder="Buscar manga..."
            class="w-44 lg:w-60 bg-bl-card border border-bl-cardBorder rounded-full pl-9 pr-4 py-1.5 text-xs text-white placeholder-bl-muted focus:outline-none focus:border-bl-primary focus:ring-1 focus:ring-bl-primary transition-all"
          />
          <svg class="w-4 h-4 text-bl-muted absolute left-3 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </form>

        <!-- PANEL ADMIN O ACCESO -->
        {session ? (
          <div class="flex items-center gap-2">
            <a
              href="/admin"
              class="flex items-center gap-1.5 text-xs font-semibold px-3 py-1.5 rounded-full bg-bl-primary/10 border border-bl-primary/40 text-bl-primary hover:bg-bl-primary hover:text-black transition-all shadow-neon-sm"
              title="Panel Administrativo"
            >
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
              <span>Admin ({session.name.split(' ')[0]})</span>
            </a>
          </div>
        ) : (
          <a
            href="/admin/login"
            class="text-xs font-medium text-gray-400 hover:text-white px-2.5 py-1.5 rounded transition-colors"
          >
            Acceder
          </a>
        )}

        <!-- BOTÓN MENÚ MÓVIL -->
        <button
          id="mobile-menu-btn"
          type="button"
          aria-label="Abrir menú"
          class="md:hidden p-2 rounded-lg text-gray-400 hover:text-white hover:bg-bl-surface transition-colors"
        >
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>

    </div>
  </div>

  <!-- MENÚ MÓVIL DESPLEGABLE -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-bl-cardBorder bg-bl-dark px-4 pt-3 pb-5 space-y-2">
    <!-- Buscador móvil -->
    <form action="/mangas" method="GET" class="relative mb-3">
      <input
        type="text"
        name="q"
        placeholder="Buscar manga..."
        class="w-full bg-bl-card border border-bl-cardBorder rounded-lg pl-9 pr-4 py-2 text-sm text-white placeholder-bl-muted focus:outline-none focus:border-bl-primary"
      />
      <svg class="w-4 h-4 text-bl-muted absolute left-3 top-3 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
      </svg>
    </form>

    {navLinks.map((link) => (
      <a
        href={link.href}
        class="block px-3 py-2 rounded-md text-base font-medium text-gray-300 hover:text-white hover:bg-bl-surface"
      >
        {link.name}
      </a>
    ))}

    {session ? (
      <a
        href="/admin"
        class="block px-3 py-2 rounded-md text-base font-medium text-bl-primary bg-bl-primary/10 border border-bl-primary/30"
      >
        Panel de Control ({session.name})
      </a>
    ) : (
      <a
        href="/admin/login"
        class="block px-3 py-2 rounded-md text-base font-medium text-gray-400 hover:text-white hover:bg-bl-surface"
      >
        Acceso Administrativo
      </a>
    )}
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');

  btn?.addEventListener('click', () => {
    menu?.classList.toggle('hidden');
  });
</script>
