---
import { getSession } from '../../lib/auth';
import '../../styles/global.css';

const session = getSession(Astro.cookies);
if (session && (session.role === 'admin' || session.role === 'editor')) {
  return Astro.redirect('/admin');
}

const error = Astro.url.searchParams.get('error');
---

<!doctype html>
<html lang="es" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Acceso Administrativo | BLK SCAN</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Outfit:wght@700;800&display=swap" rel="stylesheet" />
  </head>
  <body class="bg-bl-dark text-slate-100 min-h-screen flex items-center justify-center p-4 antialiased">
    
    <div class="w-full max-w-md space-y-6">
      
      <!-- LOGO -->
      <div class="text-center space-y-2">
        <a href="/" class="inline-flex items-center gap-2 group">
          <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-bl-primary via-bl-accent to-blue-900 flex items-center justify-center shadow-neon">
            <svg class="w-6 h-6 text-black" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/>
            </svg>
          </div>
          <span class="font-extrabold text-2xl text-white tracking-wider">
            BLK<span class="text-bl-primary">SCAN</span>
          </span>
        </a>
        <h1 class="text-xl font-bold text-white font-heading">Panel Administrativo</h1>
        <p class="text-xs text-bl-muted">Ingresa tus credenciales autorizadas para gestionar contenido.</p>
      </div>

      <!-- FORMULARIO DE ACCESO -->
      <div class="p-6 sm:p-8 rounded-2xl bg-bl-card border border-bl-cardBorder shadow-2xl space-y-5">
        
        {error && (
          <div class="p-3 rounded-xl bg-red-500/10 border border-red-500/30 text-red-400 text-xs flex items-center gap-2">
            <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <span>{error === 'invalid' ? 'Credenciales incorrectas o usuario no autorizado.' : 'Ocurrió un error al procesar el inicio de sesión.'}</span>
          </div>
        )}

        <form action="/api/auth/login" method="POST" class="space-y-4">
          <div class="space-y-1.5">
            <label class="text-xs font-semibold text-gray-300">Correo Electrónico</label>
            <input
              type="email"
              name="email"
              required
              placeholder="admin@blkscan.com"
              class="w-full bg-bl-dark border border-bl-cardBorder rounded-xl px-3.5 py-2.5 text-xs text-white placeholder-bl-muted focus:outline-none focus:border-bl-primary focus:ring-1 focus:ring-bl-primary transition-all"
            />
          </div>

          <div class="space-y-1.5">
            <label class="text-xs font-semibold text-gray-300">Contraseña</label>
            <input
              type="password"
              name="password"
              required
              placeholder="••••••••••••"
              class="w-full bg-bl-dark border border-bl-cardBorder rounded-xl px-3.5 py-2.5 text-xs text-white placeholder-bl-muted focus:outline-none focus:border-bl-primary focus:ring-1 focus:ring-bl-primary transition-all"
            />
          </div>

          <button
            type="submit"
            class="w-full py-2.5 rounded-xl bg-bl-primary text-black font-bold text-xs hover:bg-cyan-300 transition-colors shadow-neon-sm active:scale-98"
          >
            Iniciar Sesión
          </button>
        </form>

        <div class="pt-4 border-t border-bl-cardBorder/60 text-center">
          <p class="text-[11px] text-bl-muted">
            ¿Primer inicio? Ejecuta <code class="text-bl-primary font-mono bg-bl-surface px-1 py-0.5 rounded">npm run db:seed</code> para configurar el administrador.
          </p>
        </div>

      </div>

      <div class="text-center">
        <a href="/" class="text-xs text-bl-muted hover:text-white transition-colors">
          ← Volver a la portada pública
        </a>
      </div>

    </div>

  </body>
</html>
