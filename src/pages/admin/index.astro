---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { AdminService } from '../../lib/services/admin.service';
import { formatDate } from '../../lib/utils';

const stats = await AdminService.getDashboardStats();
---

<AdminLayout title="Dashboard Administrativo | BLK SCAN">
  <div class="space-y-8">
    
    <!-- ENCABEZADO -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div>
        <h1 class="text-2xl sm:text-3xl font-extrabold text-white font-heading">
          Dashboard <span class="text-bl-primary">Principal</span>
        </h1>
        <p class="text-xs text-bl-muted mt-1">
          Resumen general y estadísticas en tiempo real del catálogo de manga.
        </p>
      </div>

      <div class="flex items-center gap-2">
        <a
          href="/admin/capitulos/nuevo"
          class="px-4 py-2 rounded-xl text-xs font-bold bg-bl-primary text-black hover:bg-cyan-300 transition-colors shadow-neon-sm flex items-center gap-1.5"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2.5" d="M12 4v16m8-8H4" />
          </svg>
          <span>Nuevo Capítulo</span>
        </a>
        <a
          href="/admin/capitulos/importar-zip"
          class="px-3.5 py-2 rounded-xl text-xs font-semibold bg-bl-card border border-bl-cardBorder hover:border-bl-primary/40 text-white transition-colors flex items-center gap-1.5"
        >
          <svg class="w-4 h-4 text-bl-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12" />
          </svg>
          <span>Importar ZIP</span>
        </a>
      </div>
    </div>

    <!-- TARJETAS DE MÉTRICAS -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
      
      <!-- Total Mangas -->
      <div class="p-5 rounded-2xl bg-bl-card border border-bl-cardBorder relative overflow-hidden">
        <div class="flex items-center justify-between">
          <span class="text-xs font-semibold text-bl-muted">Mangas Totales</span>
          <span class="p-2 rounded-lg bg-bl-primary/10 text-bl-primary">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
            </svg>
          </span>
        </div>
        <p class="text-3xl font-extrabold text-white mt-3 font-heading">{stats.totalMangas}</p>
        <span class="text-[10px] text-bl-muted block mt-1">Títulos registrados</span>
      </div>

      <!-- Total Capítulos -->
      <div class="p-5 rounded-2xl bg-bl-card border border-bl-cardBorder relative overflow-hidden">
        <div class="flex items-center justify-between">
          <span class="text-xs font-semibold text-bl-muted">Capítulos Totales</span>
          <span class="p-2 rounded-lg bg-blue-500/10 text-blue-400">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
            </svg>
          </span>
        </div>
        <p class="text-3xl font-extrabold text-white mt-3 font-heading">{stats.totalChapters}</p>
        <span class="text-[10px] text-bl-muted block mt-1">En todos los mangas</span>
      </div>

      <!-- Capítulos Publicados -->
      <div class="p-5 rounded-2xl bg-bl-card border border-bl-cardBorder relative overflow-hidden">
        <div class="flex items-center justify-between">
          <span class="text-xs font-semibold text-bl-muted">Publicados</span>
          <span class="p-2 rounded-lg bg-emerald-500/10 text-emerald-400">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M5 13l4 4L19 7" />
            </svg>
          </span>
        </div>
        <p class="text-3xl font-extrabold text-emerald-400 mt-3 font-heading">{stats.publishedChapters}</p>
        <span class="text-[10px] text-emerald-400/80 block mt-1">Visibles al público</span>
      </div>

      <!-- Capítulos en Borrador -->
      <div class="p-5 rounded-2xl bg-bl-card border border-bl-cardBorder relative overflow-hidden">
        <div class="flex items-center justify-between">
          <span class="text-xs font-semibold text-bl-muted">Borradores</span>
          <span class="p-2 rounded-lg bg-amber-500/10 text-amber-400">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
            </svg>
          </span>
        </div>
        <p class="text-3xl font-extrabold text-amber-400 mt-3 font-heading">{stats.draftChapters}</p>
        <span class="text-[10px] text-amber-400/80 block mt-1">Pendientes de publicación</span>
      </div>

    </div>

    <!-- TABLAS DE CONTENIDO RECIENTE -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
      
      <!-- Últimos Capítulos -->
      <div class="p-5 rounded-2xl bg-bl-card border border-bl-cardBorder space-y-4">
        <div class="flex items-center justify-between border-b border-bl-cardBorder pb-3">
          <h2 class="text-sm font-bold text-white uppercase tracking-wider flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-bl-primary"></span>
            Últimos Capítulos Registrados
          </h2>
          <a href="/admin/capitulos" class="text-xs text-bl-primary hover:underline font-semibold">
            Ver todos
          </a>
        </div>

        {stats.recentChapters.length === 0 ? (
          <p class="text-xs text-bl-muted py-6 text-center">No hay capítulos registrados.</p>
        ) : (
          <div class="space-y-2">
            {stats.recentChapters.map((ch) => (
              <div class="flex items-center justify-between p-3 rounded-xl bg-bl-dark border border-bl-cardBorder/50 text-xs">
                <div>
                  <span class="font-bold text-white block">{ch.mangaTitle} - Cap. {ch.chapterNumber}</span>
                  {ch.title && <span class="text-[11px] text-bl-muted block">{ch.title}</span>}
                  <span class="text-[10px] text-bl-subtle">{formatDate(ch.publishedAt)}</span>
                </div>
                <span class={`px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider ${
                  ch.status === 'published'
                    ? 'bg-emerald-500/15 text-emerald-400 border border-emerald-500/30'
                    : 'bg-amber-500/15 text-amber-400 border border-amber-500/30'
                }`}>
                  {ch.status === 'published' ? 'Publicado' : 'Borrador'}
                </span>
              </div>
            ))}
          </div>
        )}
      </div>

      <!-- Mangas Registrados -->
      <div class="p-5 rounded-2xl bg-bl-card border border-bl-cardBorder space-y-4">
        <div class="flex items-center justify-between border-b border-bl-cardBorder pb-3">
          <h2 class="text-sm font-bold text-white uppercase tracking-wider flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-cyan-400"></span>
            Mangas en el Sistema
          </h2>
          <a href="/admin/mangas" class="text-xs text-bl-primary hover:underline font-semibold">
            Gestionar mangas
          </a>
        </div>

        {stats.recentMangas.length === 0 ? (
          <p class="text-xs text-bl-muted py-6 text-center">No hay mangas registrados.</p>
        ) : (
          <div class="space-y-2">
            {stats.recentMangas.map((m) => (
              <div class="flex items-center justify-between p-3 rounded-xl bg-bl-dark border border-bl-cardBorder/50 text-xs">
                <div>
                  <span class="font-bold text-white block">{m.title}</span>
                  <span class="text-[10px] text-bl-muted">Slug: /{m.slug}</span>
                </div>
                <div class="flex items-center gap-2">
                  <span class="px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider bg-blue-500/15 text-blue-400 border border-blue-500/30">
                    {m.status}
                  </span>
                  <a
                    href={`/mangas/${m.slug}`}
                    target="_blank"
                    class="p-1 rounded bg-bl-surface hover:text-bl-primary text-gray-400"
                    title="Ver ficha pública"
                  >
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                    </svg>
                  </a>
                </div>
              </div>
            ))}
          </div>
        )}
      </div>

    </div>

  </div>
</AdminLayout>
