---
import PublicLayout from '../layouts/PublicLayout.astro';
---

<PublicLayout title="Página No Encontrada (404) | BLK SCAN">
  <div class="min-h-[70vh] flex flex-col items-center justify-center text-center px-4">
    <div class="relative">
      <span class="text-8xl sm:text-9xl font-black text-transparent bg-clip-text bg-gradient-to-r from-bl-primary via-cyan-400 to-bl-accent tracking-widest font-heading select-none opacity-90">
        404
      </span>
      <div class="absolute inset-0 bg-bl-primary/20 blur-3xl rounded-full pointer-events-none"></div>
    </div>

    <h1 class="text-2xl sm:text-3xl font-extrabold text-white mt-4 font-heading">
      ¡Fuera de Juego! Página No Encontrada
    </h1>
    <p class="text-xs sm:text-sm text-bl-muted max-w-md mt-2 leading-relaxed">
      El capítulo o manga que buscas no existe o ha sido reubicado. Despierta tu ego y regresa al campo principal.
    </p>

    <div class="mt-8 flex items-center gap-4">
      <a
        href="/"
        class="px-6 py-2.5 rounded-xl text-xs font-bold bg-bl-primary text-black hover:bg-cyan-300 shadow-neon-sm transition-all"
      >
        Ir al Inicio
      </a>
      <a
        href="/mangas"
        class="px-5 py-2.5 rounded-xl text-xs font-semibold bg-bl-card border border-bl-cardBorder hover:border-bl-primary/40 text-white transition-all"
      >
        Ver Catálogo
      </a>
    </div>
  </div>
</PublicLayout>
