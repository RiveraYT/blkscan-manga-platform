---
import PublicLayout from '../layouts/PublicLayout.astro';
import HeroBanner from '../components/common/HeroBanner.astro';
import ChapterCard from '../components/catalog/ChapterCard.astro';
import MangaCard from '../components/catalog/MangaCard.astro';
import { MangaService } from '../lib/services/manga.service';

const featuredData = await MangaService.getFeaturedManga();
const latestChapters = await MangaService.getLatestChapters(8);
const catalogData = await MangaService.getCatalog({ limit: 6 });
---

<PublicLayout
  title="BLK SCAN - Plataforma de Manga Online | Blue Lock"
  description="Lee Blue Lock y los mejores mangas capítulo a capítulo en alta definición con lector interactivo de múltiples modos."
>
  <!-- BANNER PRINCIPAL BLUE LOCK -->
  {featuredData && (
    <HeroBanner
      manga={featuredData.manga}
      firstChapterNumber={featuredData.firstChapterNumber}
      totalChapters={featuredData.totalChapters}
    />
  )}

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 space-y-16">
    
    <!-- SECCIÓN: ÚLTIMOS CAPÍTULOS -->
    <section id="ultimos-capitulos" class="space-y-6">
      <div class="flex items-center justify-between border-b border-bl-cardBorder/60 pb-3">
        <div class="flex items-center gap-2.5">
          <div class="w-3 h-3 rounded-full bg-bl-primary shadow-neon-sm animate-pulse"></div>
          <h2 class="text-xl sm:text-2xl font-extrabold text-white font-heading">
            Últimos Capítulos Publicados
          </h2>
        </div>
        <a
          href="/mangas"
          class="text-xs font-semibold text-bl-primary hover:text-cyan-300 flex items-center gap-1 transition-colors"
        >
          <span>Ver catálogo</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>
      </div>

      {latestChapters.length === 0 ? (
        <div class="p-8 text-center bg-bl-card rounded-xl border border-bl-cardBorder text-bl-muted text-sm">
          No hay capítulos publicados todavía. Los nuevos lanzamientos aparecerán aquí.
        </div>
      ) : (
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
          {latestChapters.map((item) => (
            <ChapterCard chapter={item.chapter} manga={item.manga} />
          ))}
        </div>
      )}
    </section>

    <!-- SECCIÓN: CATÁLOGO DE MANGAS / TÍTULOS DESTACADOS -->
    <section class="space-y-6">
      <div class="flex items-center justify-between border-b border-bl-cardBorder/60 pb-3">
        <div class="flex items-center gap-2.5">
          <svg class="w-5 h-5 text-bl-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
          </svg>
          <h2 class="text-xl sm:text-2xl font-extrabold text-white font-heading">
            Explorar Catálogo
          </h2>
        </div>
        <a
          href="/mangas"
          class="text-xs font-semibold text-bl-primary hover:text-cyan-300 flex items-center gap-1 transition-colors"
        >
          <span>Explorar todos ({catalogData.total})</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-4 sm:gap-6">
        {catalogData.items.map((item) => (
          <MangaCard manga={item.manga} chapterCount={item.chapterCount} />
        ))}
      </div>
    </section>

    <!-- BANNER INFORMATIVO / FEATURES DEL LECTOR -->
    <section class="p-8 rounded-2xl bg-gradient-to-r from-bl-card via-bl-surface to-bl-card border border-bl-cardBorder relative overflow-hidden">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 text-center md:text-left">
        <div class="space-y-2">
          <div class="w-10 h-10 rounded-xl bg-bl-primary/20 text-bl-primary flex items-center justify-center mx-auto md:mx-0">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
            </svg>
          </div>
          <h3 class="font-bold text-white text-base">4 Modos de Lectura</h3>
          <p class="text-xs text-bl-muted">Individual, doble página, cascada vertical (Webtoon) y ajuste inteligente al monitor.</p>
        </div>

        <div class="space-y-2">
          <div class="w-10 h-10 rounded-xl bg-bl-primary/20 text-bl-primary flex items-center justify-center mx-auto md:mx-0">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
          </div>
          <h3 class="font-bold text-white text-base">Carga Progresiva</h3>
          <p class="text-xs text-bl-muted">Precarga anticipada de páginas sin bloqueos para sesiones de lectura prolongadas.</p>
        </div>

        <div class="space-y-2">
          <div class="w-10 h-10 rounded-xl bg-bl-primary/20 text-bl-primary flex items-center justify-center mx-auto md:mx-0">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M5 13l4 4L19 7" />
            </svg>
          </div>
          <h3 class="font-bold text-white text-base">Historial Guardado</h3>
          <p class="text-xs text-bl-muted">Recuerda automáticamente la última página leída y tus preferencias de lectura.</p>
        </div>
      </div>
    </section>

  </div>
</PublicLayout>
