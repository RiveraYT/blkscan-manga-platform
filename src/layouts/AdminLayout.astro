---
import { getSession } from '../lib/auth';
import '../styles/global.css';

interface Props {
  title?: string;
}

const { title = 'Panel Administrativo | BLK SCAN' } = Astro.props;

// Protección de servidor: si no está autenticado o no es admin, redirigir a login
const session = getSession(Astro.cookies);

if (!session || (session.role !== 'admin' && session.role !== 'editor')) {
  return Astro.redirect(`/admin/login?redirect=${encodeURIComponent(Astro.url.pathname)}`);
}

const currentPath = Astro.url.pathname;
const dbUrl = process.env.DATABASE_URL;
const hasDb = !!dbUrl && !dbUrl.includes('usuario:password') && !dbUrl.includes('ep-xyz');

const navItems = [
  { name: 'Dashboard', href: '/admin', icon: 'dashboard' },
  { name: 'Mangas', href: '/admin/mangas', icon: 'book' },
  { name: 'Capítulos', href: '/admin/capitulos', icon: 'list' },
  { name: 'Subir Capítulo', href: '/admin/capitulos/nuevo', icon: 'upload' },
  { name: 'Importar ZIP', href: '/admin/capitulos/importar-zip', icon: 'archive' },
];
---

<!doctype html>
<html lang="es" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Outfit:wght@600;700;800&display=swap" rel="stylesheet" />
  </head>
  <body class="bg-[#05070d] text-slate-100 min-h-screen flex flex-col antialiased">
    
    <!-- TOP BAR -->
    <header class="h-14 border-b border-bl-cardBorder bg-bl-dark/95 px-4 sm:px-6 flex items-center justify-between sticky top-0 z-40 backdrop-blur-md">
      <div class="flex items-center gap-3">
        <a href="/admin" class="flex items-center gap-2">
          <div class="w-7 h-7 rounded-lg bg-gradient-to-br from-bl-primary to-bl-accent flex items-center justify-center shadow-neon-sm">
            <svg class="w-4 h-4 text-black" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/>
            </svg>
          </div>
          <span class="font-extrabold text-base text-white tracking-wider">
            BLK<span class="text-bl-primary">ADMIN</span>
          </span>
        </a>

        <!-- Indicador de base de datos -->
        <span class={`hidden sm:inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[10px] font-mono border ${
          hasDb
            ? 'bg-emerald-500/10 text-emerald-400 border-emerald-500/30'
            : 'bg-amber-500/10 text-amber-300 border-amber-500/30'
        }`}>
          <span class={`w-1.5 h-1.5 rounded-full ${hasDb ? 'bg-emerald-400' : 'bg-amber-400 animate-pulse'}`}></span>
          {hasDb ? 'Neon PostgreSQL Conectado' : 'Modo Demostración Local'}
        </span>
      </div>

      <div class="flex items-center gap-4">
        <a
          href="/"
          target="_blank"
          class="text-xs text-bl-muted hover:text-white flex items-center gap-1 transition-colors"
        >
          <span>Ver Sitio Web</span>
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </a>

        <div class="h-4 w-[1px] bg-bl-cardBorder"></div>

        <div class="flex items-center gap-2">
          <span class="text-xs font-semibold text-white">{session.name}</span>
          <form action="/api/auth/logout" method="POST" class="inline">
            <button
              type="submit"
              class="px-2.5 py-1 rounded-md text-xs font-semibold bg-bl-card border border-bl-cardBorder hover:border-red-500/50 hover:text-red-400 text-bl-muted transition-colors"
            >
              Salir
            </button>
          </form>
        </div>
      </div>
    </header>

    <!-- CUERPO CON SIDEBAR -->
    <div class="flex-1 flex">
      <!-- SIDEBAR NAVEGACIÓN -->
      <aside class="w-56 shrink-0 border-r border-bl-cardBorder/60 bg-bl-dark/50 hidden md:flex flex-col justify-between p-4">
        <nav class="space-y-1">
          {navItems.map((item) => {
            const isActive = currentPath === item.href || (item.href !== '/admin' && currentPath.startsWith(item.href));
            return (
              <a
                href={item.href}
                class={`flex items-center gap-2.5 px-3 py-2 rounded-xl text-xs font-semibold transition-all ${
                  isActive
                    ? 'bg-bl-primary/10 text-bl-primary border border-bl-primary/30 shadow-neon-sm'
                    : 'text-gray-300 hover:text-white hover:bg-bl-surface'
                }`}
              >
                <span>{item.name}</span>
              </a>
            );
          })}
        </nav>

        <div class="p-3 rounded-xl bg-bl-card border border-bl-cardBorder text-[11px] text-bl-muted space-y-1">
          <span class="font-bold text-white block">Almacenamiento</span>
          <span class="text-[10px] block font-mono text-cyan-400">
            {process.env.STORAGE_TYPE === 's3' ? 'AWS / Cloudflare R2' : 'Directorio Local'}
          </span>
        </div>
      </aside>

      <!-- ÁREA DE CONTENIDO -->
      <main class="flex-1 p-4 sm:p-6 lg:p-8 max-w-7xl">
        <slot />
      </main>
    </div>

  </body>
</html>
