# ==========================================
# CONFIGURACIÓN DE BASE DE DATOS (NEON POSTGRESQL)
# ==========================================
# Obtén tu connection string en https://console.neon.tech
# Ejemplo: postgresql://neondb_owner:npg_xxxx@ep-cool-fog-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://usuario:password@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require"

# ==========================================
# SEGURIDAD Y SESIÓN ADMINISTRATIVA
# ==========================================
# Secreto para firmar y validar tokens de sesión JWT/Cookie (mínimo 32 caracteres)
SESSION_SECRET="blkscan_super_secure_jwt_secret_change_me_in_production_32chars"

# Credenciales para el primer administrador creado con el comando: npm run db:seed
ADMIN_NAME="Ego Jinpachi"
ADMIN_EMAIL="admin@blkscan.com"
ADMIN_PASSWORD="CambiaEstaContrasenaSegura2026!"

# ==========================================
# ALMACENAMIENTO DE IMÁGENES (S3 / CLOUDFLARE R2)
# ==========================================
# Tipo de almacenamiento: 's3' (producción) o 'local' (desarrollo local sin S3)
STORAGE_TYPE="local"

# Si STORAGE_TYPE="s3", completa las siguientes credenciales:
S3_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
S3_BUCKET_NAME="blkscan-manga-storage"
S3_ACCESS_KEY_ID="tu_access_key_id"
S3_SECRET_ACCESS_KEY="tu_secret_access_key"
S3_REGION="auto"
# Dominio público configurado para servir las imágenes del bucket (con CDN o custom domain)
S3_PUBLIC_DOMAIN="https://images.tudominio.com"

# ==========================================
# CONFIGURACIÓN DEL SERVIDOR
# ==========================================
PORT=4321
HOST=0.0.0.0
NODE_ENV=development
